<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- ============================================================
         Known vulnerabilities in Spring Boot 2.6.3 dependency tree.
         These are accepted risks for the current framework version.
         Remove suppressions as dependencies are upgraded.
         ============================================================ -->

    <!-- Spring Framework 5.3.15 -->
    <suppress>
        <notes><![CDATA[Spring Framework 5.3.15 — known CVEs accepted for Spring Boot 2.6.3]]></notes>
        <filePath regex="true">.*spring-(aop|beans|context|core|expression|jcl|jdbc|tx|web|webmvc|webflux|websocket|messaging)-5\.3\.15\.jar</filePath>
        <cpe regex="true">cpe:/a:vmware:spring_framework.*</cpe>
    </suppress>
    <suppress>
        <notes><![CDATA[Spring Framework 5.3.15 — pivotal CPE]]></notes>
        <filePath regex="true">.*spring-(aop|beans|context|core|expression|jcl|jdbc|tx|web|webmvc|webflux|websocket|messaging)-5\.3\.15\.jar</filePath>
        <cpe regex="true">cpe:/a:pivotal_software:spring_framework.*</cpe>
    </suppress>

