<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.spring.infrastructure.mybatis.readservice.ArticleStatisticsReadService">
    <select id="countFavoritesByArticleId" resultType="java.lang.Integer">
        select count(1) from article_favorites where article_id = #{articleId}
    </select>

    <select id="countCommentsByArticleId" resultType="java.lang.Integer">
        select count(1) from comments where article_id = #{articleId}
    </select>

    <resultMap id="trendingArticleData" type="io.spring.application.data.TrendingArticleData">
        <id column="id" property="id"/>
        <result column="slug" property="slug"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="favoriteCount" property="favoriteCount"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findTrendingArticles" resultMap="trendingArticleData">
        select
            A.id,
            A.slug,
            A.title,
            A.description,
            count(AF.user_id) as favoriteCount,
            A.created_at
        from articles A
        inner join article_favorites AF on A.id = AF.article_id
        where A.created_at >= #{since}
        group by A.id
        order by favoriteCount desc
        limit #{limit}
    </select>
</mapper>
