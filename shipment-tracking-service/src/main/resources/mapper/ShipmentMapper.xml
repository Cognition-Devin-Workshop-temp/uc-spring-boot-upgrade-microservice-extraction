<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.spring.shipment.infrastructure.mybatis.mapper.ShipmentMapper">

    <resultMap id="shipmentResult" type="io.spring.shipment.core.Shipment">
        <id property="id" column="id"/>
        <result property="trackingNumber" column="tracking_number"/>
        <result property="senderName" column="sender_name"/>
        <result property="senderAddress" column="sender_address"/>
        <result property="recipientName" column="recipient_name"/>
        <result property="recipientAddress" column="recipient_address"/>
        <result property="origin" column="origin"/>
        <result property="destination" column="destination"/>
        <result property="weight" column="weight"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert">
        insert into shipments (id, tracking_number, sender_name, sender_address,
            recipient_name, recipient_address, origin, destination, weight, status,
            created_at, updated_at)
        values (#{shipment.id}, #{shipment.trackingNumber}, #{shipment.senderName},
            #{shipment.senderAddress}, #{shipment.recipientName}, #{shipment.recipientAddress},
            #{shipment.origin}, #{shipment.destination}, #{shipment.weight},
            #{shipment.status}, #{shipment.createdAt}, #{shipment.updatedAt})
    </insert>

    <select id="findById" resultMap="shipmentResult">
        select * from shipments where id = #{id}
    </select>

    <select id="findByTrackingNumber" resultMap="shipmentResult">
        select * from shipments where tracking_number = #{trackingNumber}
    </select>

    <select id="findAll" resultMap="shipmentResult">
        select * from shipments order by created_at desc limit #{limit} offset #{offset}
    </select>

    <select id="count" resultType="int">
        select count(*) from shipments
    </select>

    <update id="update">
        update shipments
        set status = #{shipment.status},
            updated_at = #{shipment.updatedAt}
        where id = #{shipment.id}
    </update>

    <delete id="delete">
        delete from shipments where id = #{id}
    </delete>

</mapper>
